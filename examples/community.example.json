{
  "server": {
    "name": "Example Community",
    "url": "https://launcher.example.com",
    "realm": "realm.example.com",
    "news_url": "https://launcher.example.com/news.json",
    "featured_news_url": "https://launcher.example.com/news/featured.json",
    "mods_registry_url": "https://launcher.example.com/community.mods.example.json",
    "addons_registry_url": "https://launcher.example.com/community.addons.example.json",
    "assets_registry_url": "https://launcher.example.com/community.assets.example.json",
    "download": {
      "update": true,
      "torrent": {
        "torrent_url": "https://launcher.example.com/client/latest/client.torrent",
        "magnet": "magnet:?xt=urn:btih:EXAMPLEINFOHASH0123456789abcdef0123456789ab&dn=client",
        "update": true
      },
      "http": {
        "fallback": "https://launcher.example.com/client/latest/client.zip"
      },
      "content": { "type": "zip" }
    }
  },
  "addons": [
    {
      "name": "ExampleAddon",
      "git": "https://github.com/example/example-addon",
      "branch": "master",
      "description": "An addon embedded directly in the launcher config.",
      "toc": { "Title": "Example Addon", "Interface": "11200" },
      "recommended": true
    }
  ],
  "assets": [
    {
      "id": "ExamplePatch",
      "name": "Example Content Patch",
      "description": "A server content patch embedded in the config.",
      "url": "https://launcher.example.com/patches/patch.mpq",
      "dest": "Data/patch.mpq",
      "version": "v1",
      "sha1": "0123456789abcdef0123456789abcdef01234567"
    }
  ],
  "mods": [
    {
      "id": "ExampleDirectDll",
      "type": "mod",
      "installation": "user_opt_in",
      "name": "Example Direct DLL",
      "description": "A single-file mod downloaded straight from a pinned URL.",
      "repo_url": "https://github.com/example/example-mod",
      "source": {
        "kind": "direct_file",
        "url": "https://launcher.example.com/mods/example_mod.dll",
        "dest": "example_mod.dll",
        "pinned_version": "v1.0.0"
      },
      "register_dll": ["example_mod.dll"],
      "installed_files": ["example_mod.dll"]
    },
    {
      "id": "ExampleReleaseMod",
      "type": "mod",
      "installation": "user_opt_in",
      "name": "Example Release Mod",
      "description": "A mod installed from its latest GitHub release archive.",
      "repo_url": "https://github.com/example/example-release-mod",
      "source": {
        "kind": "github_release",
        "owner": "example",
        "repo": "example-release-mod",
        "asset_pattern": "example-mod-*.zip",
        "prefer_no": null,
        "extract_map": {
          "ExampleMod.dll": "ExampleMod.dll"
        }
      },
      "register_dll": ["ExampleMod.dll"],
      "installed_files": ["ExampleMod.dll"]
    }
  ]
}
