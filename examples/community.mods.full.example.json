[
  {
    "id": "example-tweak",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleTweak",
    "description": "github_release — asset picked by glob `asset_pattern`; `prefer_no` deprioritises candidates containing that substring.",
    "repo_url": "https://github.com/example-community/example-tweak",
    "source": {
      "kind": "github_release",
      "owner": "example-community",
      "repo": "example-tweak",
      "asset_pattern": "example-tweak-*.zip",
      "prefer_no": null,
      "extract_map": {
        "ExampleTweak.dll": "ExampleTweak.dll"
      }
    },
    "register_dll": ["ExampleTweak.dll"],
    "installed_files": ["ExampleTweak.dll"],
    "client_versions": ["1.12.1"]
  },
  {
    "id": "example-tweak-asset-version",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleTweakAssetVersion",
    "description": "github_release with version_from=asset — version derived from asset filename (for repos with a static tag).",
    "repo_url": "https://github.com/example-community/example-tweak",
    "source": {
      "kind": "github_release",
      "owner": "example-community",
      "repo": "example-tweak",
      "asset_pattern": "superwow-*.zip",
      "extract_map": {
        "SuperWoW.dll": "SuperWoW.dll"
      },
      "version_from": "asset"
    },
    "register_dll": ["SuperWoW.dll"],
    "installed_files": ["SuperWoW.dll"]
  },
  {
    "id": "example-codeberg",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleCodeberg",
    "description": "codeberg_release — same fields as github_release but served from codeberg.org Gitea API.",
    "repo_url": "https://codeberg.org/example-community/example-codeberg",
    "source": {
      "kind": "codeberg_release",
      "owner": "example-community",
      "repo": "example-codeberg",
      "asset_pattern": "example-codeberg-*.zip",
      "extract_map": {
        "CodebergMod.dll": "CodebergMod.dll"
      }
    },
    "register_dll": ["CodebergMod.dll"],
    "installed_files": ["CodebergMod.dll"]
  },
  {
    "id": "example-direct-dll",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleDirectDll",
    "description": "direct_file streaming — single file streamed to `dest` beside its final location (supports large MPQ/archives).",
    "repo_url": "https://github.com/example-community/example-direct",
    "source": {
      "kind": "direct_file",
      "url": "https://launcher.example.com/mods/example_mod.dll",
      "dest": "example_mod.dll",
      "pinned_version": "v1.0.0"
    },
    "register_dll": ["example_mod.dll"],
    "installed_files": ["example_mod.dll"],
    "client_versions": ["1.12.1"]
  },
  {
    "id": "example-direct-integrity",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleDirectIntegrity",
    "description": "direct_file with sha1+size integrity pins — download rejected on mismatch.",
    "repo_url": "https://github.com/example-community/example-direct",
    "source": {
      "kind": "direct_file",
      "url": "https://launcher.example.com/mods/secure.dll",
      "dest": "secure.dll",
      "pinned_version": "v2.0.0",
      "sha1": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "size": 123456
    },
    "register_dll": ["secure.dll"],
    "installed_files": ["secure.dll"]
  },
  {
    "id": "example-direct-archive",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleDirectArchive",
    "description": "direct_file archive — fetched into memory and extracted via extract_map (zip or tar.gz by URL extension).",
    "repo_url": "https://github.com/example-community/example-archive",
    "source": {
      "kind": "direct_file",
      "url": "https://launcher.example.com/mods/example_archive.zip",
      "extract_map": {
        "ExampleArchive.dll": "ExampleArchive.dll",
        "ExampleArchive.conf": "ExampleArchive.conf"
      },
      "pinned_version": "v1.1.0"
    },
    "register_dll": ["ExampleArchive.dll"],
    "installed_files": ["ExampleArchive.dll", "ExampleArchive.conf"]
  },
  {
    "id": "example-tar",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleTar",
    "description": "direct_tar — requires extract_map; supports fnmatch globs in the archive member pattern.",
    "repo_url": "https://github.com/example-community/example-tar",
    "source": {
      "kind": "direct_tar",
      "url": "https://launcher.example.com/mods/example_tar.tar.gz",
      "extract_map": {
        "build/*.dll": "ExampleTar.dll",
        "build/config.ini": "ExampleTar.ini"
      },
      "pinned_version": "v3.0.0"
    },
    "register_dll": ["ExampleTar.dll"],
    "installed_files": ["ExampleTar.dll", "ExampleTar.ini"]
  },
  {
    "id": "example-git-archive",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleGitArchive",
    "description": "git_archive — fetches archive zip at `ref`/`branch` commit (GitHub/GitLab/Gitea/Codeberg allowlisted hosts).",
    "repo_url": "https://github.com/example-community/example-git",
    "source": {
      "kind": "git_archive",
      "git": "https://github.com/example-community/example-git",
      "branch": "main",
      "ref": "v1.0.0"
    },
    "register_dll": ["ExampleGitArchive.dll"],
    "installed_files": ["ExampleGitArchive.dll"]
  },
  {
    "id": "example-loader",
    "type": "external-launcher",
    "installation": "required",
    "name": "ExampleLoader",
    "description": "external-launcher — provides the game executable the launcher starts when installed and enabled.",
    "repo_url": "https://github.com/example-community/example-loader",
    "source": {
      "kind": "github_release",
      "owner": "example-community",
      "repo": "example-loader",
      "asset_pattern": "example-loader-*.zip",
      "prefer_no": null,
      "extract_map": {
        "ExampleLoaderHook.dll": "ExampleLoaderHook.dll",
        "ExampleLoader.exe": "ExampleLoader.exe"
      }
    },
    "register_dll": ["ExampleLoaderHook.dll"],
    "installed_files": ["ExampleLoaderHook.dll", "ExampleLoader.exe"],
    "executable": "ExampleLoader.exe",
    "client_versions": ["1.12.1"]
  },
  {
    "id": "example-dxvk",
    "type": "mod",
    "installation": "user_opt_in",
    "name": "ExampleDxvk",
    "description": "Mod with post_install hook — only allowlisted hooks (currently `write_dxvk_conf`) accepted, and only for type `mods`.",
    "repo_url": "https://github.com/example-community/example-dxvk",
    "source": {
      "kind": "direct_tar",
      "url": "https://launcher.example.com/mods/dxvk.tar.gz",
      "extract_map": {
        "d3d9.dll": "d3d9.dll"
      },
      "post_install": ["write_dxvk_conf"]
    },
    "register_dll": ["d3d9.dll"],
    "installed_files": ["d3d9.dll"]
  },
  {
    "id": "example-multi-dll",
    "type": "mod",
    "installation": "required",
    "name": "ExampleMultiDll",
    "description": "Mod registering multiple DLLs — `register_dll` must be a non-empty list of safe_relative_path entries.",
    "repo_url": "https://github.com/example-community/example-multi",
    "source": {
      "kind": "github_release",
      "owner": "example-community",
      "repo": "example-multi",
      "asset_pattern": "example-multi-*.zip",
      "extract_map": {
        "A.dll": "A.dll",
        "B.dll": "B.dll"
      }
    },
    "register_dll": ["A.dll", "B.dll"],
    "installed_files": ["A.dll", "B.dll"]
  }
]
